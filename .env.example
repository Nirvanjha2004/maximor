# Copy this file to .env and fill in your key before running in --live mode
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model used by the worker agent
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenRouter (free models, $0 cost) — get a key at https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Comma-separated fallback chain if the primary free model rate-limits:
# OPENROUTER_FALLBACKS=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,nvidia/nemotron-3-super-120b-a12b:free,minimax/minimax-m2.7:free
